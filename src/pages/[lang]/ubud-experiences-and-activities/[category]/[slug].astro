---
// Import dependencies and components
import Layout from '../../../../layouts/Base.astro';
import client from '../../../../lib/sanityClient';
import { getLocale } from '../../../../utils/getLocale';
import OptimizedImage from '../../../../components/OptimizedImage.astro';
import { toHTML } from '@portabletext/to-html';

// Get route parameters and locale
const { lang, category, slug } = Astro.params;
const locale = getLocale(lang);
const safeArray = arr => Array.isArray(arr) ? arr : [];

// Fetch experience data from Sanity CMS
const experience = await client.fetch(`*[
  _type == "experienceUnique"
  && slug.current == $slug
][0]{
  title,
  subtitle,
  excerpt,
  description,
  mainImage {
    asset->{url}
  },
  mainImageAlt,
  headerImages[]{
    image {
      asset->{url}
    },
    alt,
    title,
    order
  },
  metaTitle,
  metaDescription,
  metaKeywords,
  order,
  "detail": detail[$locale],
  "menu": menu[$locale],
  "contact": contact[$locale],

  category->{
    title,
    slug
  }
}`, { slug, category, locale });

// Generate static paths for all languages, categories, and slugs
export async function getStaticPaths() {
  const experiences = await client.fetch(`*[
    _type == "experienceUnique"
    && defined(slug.current)
  ]{
    "slug": slug.current,
    "category": coalesce(
      category->slug.current,
      category.slug.current,
      "signature-experiences"
    )
  }`);

  const languages = ['en', 'ko', 'zh'];

  return languages.flatMap(lang =>
    experiences.map(experience => ({
      params: {
        lang,
        category: experience.category || 'signature-experiences',
        slug: experience.slug,
      },
    }))
  );
}

// If experience not found, return 404
if (!experience) {
  return Astro.redirect(`/${lang}/ubud-experiences-and-activities`);
}

// Prepare experience header slider images
const experienceHeaderSlides =
  Array.isArray(experience?.headerImages) && experience.headerImages.length
    ? experience.headerImages
        .filter(slide => slide?.image?.asset?.url)
        .sort((a, b) => (a.order ?? 999) - (b.order ?? 999))
    : experience?.mainImage?.asset?.url
      ? [
          {
            image: experience.mainImage,
            alt: experience.mainImageAlt,
            title: experience.title,
            order: 1,
          },
        ]
      : [];

const portableTextComponents = {
  block: ({ children, value }) => {
    if (!children?.trim()) return '';

    const style = value?.style;
    if (/^h[1-6]$/.test(style)) {
      return `<${style}>${children}</${style}>`;
    }

    return `<p>${children.replace(/\n/g, '<br>')}</p>`;
  },
  list: ({ children, value }) => {
    const type = value?.listItem ?? value?.type;
    return type === 'number'
      ? `<ol class="list-decimal ml-6">${children}</ol>`
      : `<ul class="list-disc ml-6">${children}</ul>`;
  },
  listItem: ({ children }) => `<li>${children}</li>`,
};

// Convert Portable Text fields to HTML for rendering
const detailHTML = toHTML(safeArray(experience.detail), {
  components: portableTextComponents,
});

const menuHTML = toHTML(safeArray(experience.menu), {
  components: portableTextComponents,
});

const htmlOpts = {
  components: portableTextComponents,
};

const contactHTML = toHTML(safeArray(experience.contact), htmlOpts);

// Prepare meta tags and Open Graph data
const title = experience?.metaTitle?.[locale] ?? experience?.title?.[locale] ?? '';
const description = experience?.metaDescription?.[locale] ?? experience?.description?.[locale] ?? experience?.excerpt?.[locale] ?? '';
const baseUrl = new URL(Astro.request.url);
const url = baseUrl.href;
const ogImage =
  experienceHeaderSlides[0]?.image?.asset?.url ??
  experience.mainImage?.asset?.url ??
  '';
const keywords = experience?.metaKeywords?.[locale] ?? '';
---

<Layout {title} {description} {url} {ogImage} {keywords}>
  {/* Hero section with header slider */}
  <section class="relative w-full h-[50vh] md:h-[60vh] lg:h-[75vh] overflow-hidden">
    <div id="experience-detail-header-carousel" class="w-full h-full relative">
      {experienceHeaderSlides.map((slide, i) => (
        <div
          class={`experience-detail-header-slide w-full h-full absolute inset-0 transition-opacity duration-1000 ${
            i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'
          }`}
        >
          <OptimizedImage
            src={slide.image?.asset?.url ?? ''}
            alt={slide.alt?.[locale] ?? slide.title?.[locale] ?? experience.mainImageAlt?.[locale] ?? ''}
            width={1600}
            height={900}
            className="w-full h-full object-cover"
            fetchpriority={i === 0 ? 'high' : 'auto'}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </div>
      ))}

      <div class="absolute inset-0 bg-black/25 z-20"></div>

      {experienceHeaderSlides.length > 1 && (
        <>
          <button
            aria-label="Previous Experience Detail Header Slide"
            id="experienceDetailHeaderPrev"
            class="absolute left-4 top-1/2 -translate-y-1/2 text-white text-3xl z-30"
          >
            ❮
          </button>

          <button
            aria-label="Next Experience Detail Header Slide"
            id="experienceDetailHeaderNext"
            class="absolute right-4 top-1/2 -translate-y-1/2 text-white text-3xl z-30"
          >
            ❯
          </button>
        </>
      )}
    </div>
  </section>

  {/* Title and description section */}
  <section class="container mx-auto px-4 xl:px-10 2xl:px-0 py-16 md:py-24">
    <div class="text-center px-2 sm:px-6 md:px-8 mx-auto">
      <h1 class="font-title text-3xl sm:text-4xl md:text-5xl uppercase mb-4 md:mb-6 tracking-widest font-light">
        {experience?.title?.[locale] ?? ''}
      </h1>
      <div class="text-xl sm:text-2xl md:text-3xl mb-4 md:mb-6 tracking-widest font-light">{experience?.subtitle?.[locale] ?? ''}</div>
      <p class="text-lg md:text-2xl">
        {experience?.description?.[locale] ?? ''}
      </p>
    </div>
  </section>

  {/* Details and reservation section */}
  <section class="container mx-auto px-4 xl:px-10 2xl:px-0 pb-16 md:pb-24">
    <div class="flex flex-col lg:flex-row justify-between gap-12">
      {/* Experience details */}
      <div class="lg:w-3/5">
        <h3 class="font-title text-xl md:text-2xl uppercase mb-6 tracking-widest font-light">INCLUSIONS & DETAILS</h3>
        <div class="experience-rich-text max-w-none" set:html={detailHTML}></div>
      </div>

      {/* Reservation and contact info */}
      <div class="lg:w-2/5 flex flex-col items-end">
        <div>
          <h3 class="font-title text-xl md:text-2xl mb-6 tracking-widest font-light">Reserve This Experience</h3>
          <div class="experience-rich-text mb-6" set:html={contactHTML}></div>
          <a
            href={`https://wa.me/+628113984566`}
            class="inline-block px-4 py-3 md:px-4 md:py-2 text-xs font-title tracking-widest border bg-[#916B2C] text-white border-transparent hover:bg-white hover:text-black hover:border-black transition-colors duration-300 text-center"
            target="_blank"
            rel="noopener noreferrer"
          >
            Inquire & Reserve
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Accordion section for more information */}
  {menuHTML.trim()
    ? (
      <section class="container mx-auto px-4 xl:px-10 2xl:px-0 pb-12">
        <div class="border-t border-b border-gray-300">
          <button
            type="button"
            class="w-full flex justify-between items-center py-4 font-title text-left text-lg uppercase toggle-btn"
            data-target="accordion-1"
            aria-expanded="false"
            aria-controls="accordion-1"
          >
            More Information

            <svg
              class="w-5 h-5 transition-transform duration-300"
              data-icon
              data-target="accordion-1"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div
            id="accordion-1"
            class="grid grid-cols-1 md:grid-cols-2 gap-6 pb-6 hidden"
            role="region"
            aria-labelledby="accordion-1"
          >
            <div class="experience-rich-text max-w-none" set:html={menuHTML}></div>
          </div>
        </div>
      </section>
    )
    : null
  }

  {/* Experience Detail Header Carousel Script */}
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const slides = document.querySelectorAll('.experience-detail-header-slide');
      const prevButton = document.getElementById('experienceDetailHeaderPrev');
      const nextButton = document.getElementById('experienceDetailHeaderNext');

      if (!slides.length) return;

      let currentSlide = 0;

      function showExperienceDetailHeaderSlide(index) {
        slides.forEach((slide, i) => {
          if (i === index) {
            slide.classList.add('opacity-100', 'z-10');
            slide.classList.remove('opacity-0', 'z-0');
          } else {
            slide.classList.add('opacity-0', 'z-0');
            slide.classList.remove('opacity-100', 'z-10');
          }
        });
      }

      function nextExperienceDetailHeaderSlide() {
        currentSlide = (currentSlide + 1) % slides.length;
        showExperienceDetailHeaderSlide(currentSlide);
      }

      function prevExperienceDetailHeaderSlide() {
        currentSlide = (currentSlide - 1 + slides.length) % slides.length;
        showExperienceDetailHeaderSlide(currentSlide);
      }

      prevButton?.addEventListener('click', e => {
        e.stopPropagation();
        prevExperienceDetailHeaderSlide();
      });

      nextButton?.addEventListener('click', e => {
        e.stopPropagation();
        nextExperienceDetailHeaderSlide();
      });

      if (slides.length > 1) {
        setInterval(nextExperienceDetailHeaderSlide, 5000);
      }

      showExperienceDetailHeaderSlide(currentSlide);
    });
  </script>

  {/* Accordion toggle script */}
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.toggle-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const targetId = btn.dataset.target;
          const panel = document.getElementById(targetId);
          const icon = document.querySelector(`svg[data-icon][data-target="${targetId}"]`);
          const expanded = btn.getAttribute('aria-expanded') === 'true';

          btn.setAttribute('aria-expanded', String(!expanded));

          if (panel) {
            panel.classList.toggle('hidden');
          }

          if (icon) {
            icon.classList.toggle('rotate-180');
          }
        });
      });
    });
  </script>

  <style>
    .experience-rich-text {
      color: #1f2a44;
      font-size: 1rem;
      line-height: 1.5;
      letter-spacing: 0.035em;
    }

    .experience-rich-text :global(p) {
      margin: 0;
    }

    .experience-rich-text :global(p + p) {
      margin-top: 0.18rem;
    }

    .experience-rich-text :global(p:empty),
    .experience-rich-text :global(p:has(> br:only-child)) {
      display: none;
    }

    .experience-rich-text :global(strong) {
      display: inline-block;
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .experience-rich-text :global(p:has(> strong:only-child)) {
      margin-top: 0.75rem;
      margin-bottom: 0.25rem;
    }

    .experience-rich-text :global(p:first-child:has(> strong:only-child)) {
      margin-top: 0;
    }

    .experience-rich-text :global(ul + p:has(> strong:only-child)),
    .experience-rich-text :global(ol + p:has(> strong:only-child)) {
      margin-top: 0.75rem;
    }

    .experience-rich-text :global(p:not(:has(> strong:only-child)) + p:has(> strong:only-child)) {
      margin-top: 0.85rem;
    }

    .experience-rich-text :global(ul),
    .experience-rich-text :global(ol) {
      margin: 0.15rem 0 1.6rem 1.25rem !important;
      padding: 0 !important;
    }

    .experience-rich-text :global(li) {
      padding-left: 0.25rem !important;
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }

    .experience-rich-text :global(ul > :not([hidden]) ~ :not([hidden])),
    .experience-rich-text :global(ol > :not([hidden]) ~ :not([hidden])) {
      margin-top: 0.08rem !important;
    }

    .experience-rich-text :global(li::marker) {
      font-size: 0.75em;
      color: #1f2a44;
    }

    @media (min-width: 768px) {
      .experience-rich-text {
        font-size: 1.0625rem;
      }
    }
  </style>
</Layout>
