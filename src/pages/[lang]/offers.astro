---
import Layout from '../../layouts/Base.astro';
import client from '../../lib/sanityClient';
import { getLocale } from '../../utils/getLocale';
import OptimizedImage from '../../components/OptimizedImage.astro';
import { toHTML } from '@portabletext/to-html';

// Generate static paths for each language
export async function getStaticPaths() {
  return ['en', 'ko', 'zh'].map(lang => ({ params: { lang } }));
}

// Get current language from params and locale helper
const { lang } = Astro.params;
const locale = getLocale(lang);

// Helper to ensure a value is always an array
const safeArray = arr => Array.isArray(arr) ? arr : [];

// Fetch page details from Sanity CMS
const pageDetails = await client.fetch(`*[_type == "page" && _id == "2ff8dda1-8c5a-4622-b79c-e217495e327f"][0]{
  title, subtitle, description, metaTitle, metaDescription, metaKeywords,
  mainImageAlt, mainImage { asset->{url} },
  headerImages[]{
    image {
      asset->{url}
    },
    alt,
    title,
    order
  }
}`);

// Fetch all offers from Sanity CMS, ordered by 'order'
const offers = await client.fetch(`*[_type == "offer"] | order(orderNumber asc){
  "slug": slug.current, title, subtitle, excerpt, buttonLabel, buttonValue,
  mainImage { asset->{url} }, mainImageAlt,
  secondImage { asset->{url} }, secondImageAlt
}`);

// Prepare offers header slider images
const offersHeaderSlides =
  Array.isArray(pageDetails?.headerImages) && pageDetails.headerImages.length
    ? pageDetails.headerImages
        .filter(slide => slide?.image?.asset?.url)
        .sort((a, b) => (a.order ?? 999) - (b.order ?? 999))
    : pageDetails?.mainImage?.asset?.url
      ? [
          {
            image: pageDetails.mainImage,
            alt: pageDetails.mainImageAlt,
            title: pageDetails.title,
            order: 1,
          },
        ]
      : [];

// Prepare meta and content variables for the page
const pageDescription = toHTML(safeArray(pageDetails.description?.[locale]));
const title = pageDetails?.metaTitle?.[locale] ?? '';
const description = pageDetails?.metaDescription?.[locale] ?? '';
const url = new URL(Astro.request.url).href;
const ogImage =
  offersHeaderSlides[0]?.image?.asset?.url ??
  pageDetails.mainImage?.asset?.url ??
  '';
const keywords = pageDetails.metaKeywords ?? '';
---

<Layout {title} {description} {url} {ogImage} {keywords}>
  {/* Hero section with header slider */}
  <section class="relative w-full h-[50vh] md:h-[60vh] lg:h-[75vh] overflow-hidden">
    <div id="offers-header-carousel" class="w-full h-full relative">
      {offersHeaderSlides.map((slide, i) => (
        <div
          class={`offers-header-slide w-full h-full absolute inset-0 transition-opacity duration-1000 ${
            i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'
          }`}
        >
          <OptimizedImage
            src={slide.image?.asset?.url ?? ''}
            alt={slide.alt?.[locale] ?? slide.title?.[locale] ?? pageDetails.mainImageAlt?.[locale] ?? ''}
            width={1600}
            height={900}
            className="w-full h-full object-cover"
            fetchpriority={i === 0 ? 'high' : 'auto'}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </div>
      ))}

      <div class="absolute inset-0 bg-black/25 z-20"></div>

      {offersHeaderSlides.length > 1 && (
        <>
          <button
            aria-label="Previous Offers Header Slide"
            id="offersHeaderPrev"
            class="absolute left-4 top-1/2 -translate-y-1/2 text-white text-3xl z-30"
          >
            &#10094;
          </button>

          <button
            aria-label="Next Offers Header Slide"
            id="offersHeaderNext"
            class="absolute right-4 top-1/2 -translate-y-1/2 text-white text-3xl z-30"
          >
            &#10095;
          </button>
        </>
      )}
    </div>
  </section>

  {/* Page title and description */}
  <section class="container mx-auto px-4 xl:px-10 2xl:px-0 pt-16 md:pt-24">
    <div class="text-center px-2 sm:px-6 md:px-8 mx-auto">
      <h1 class="font-title text-3xl sm:text-4xl md:text-5xl mb-4 md:mb-6 tracking-widest font-light">
        {pageDetails?.title?.[locale] ?? ''}
      </h1>
      <div class="mb-12 md:mb-18 text-xl" set:html={pageDescription}></div>
    </div>
  </section>

  {/* Offers grid section */}
  <section class="container mx-auto px-4 xl:px-10 2xl:px-0 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {offers.map((offer) => (
        // Single offer card
        <div class="transition-transform duration-500 ease-in-out bg-white overflow-hidden flex flex-col h-full">
          <OptimizedImage
            src={offer.secondImage?.asset?.url ?? offer.mainImage?.asset?.url}
            alt={offer.secondImageAlt?.[locale] ?? offer.mainImageAlt?.[locale] ?? 'Offer image'}
            width={800} height={600} loading="lazy"
            className="w-full h-auto aspect-[4/3] transition duration-500"
          />
          <div class="py-4 md:py-6 flex flex-col flex-1">
            <h3 class="text-lg tracking-widest uppercase font-title">
              {offer.title?.[locale] ?? offer.title?.en}
            </h3>
{(offer.subtitle?.[locale] ?? offer.subtitle?.en) && (
  <h4 class="mt-2 text-lg">
    {offer.subtitle?.[locale] ?? offer.subtitle?.en}
  </h4>
)}
            <div class="flex-grow"></div>
            {/* Offer action buttons */}
            <div class="mt-6 flex flex-wrap gap-4 lg:mb-20 mb-10">
              <a
                href={`/${locale}/offer/${offer.slug}`}
                class="bg-white text-black px-4 py-3 md:px-4 md:py-2 text-xs font-title tracking-widest transition-colors duration-300 border border-black hover:bg-[#916B2C] hover:text-white hover:border-transparent inline-block text-center"
              >Details</a>

{(offer?.buttonValue) ? (
              <a
                href={offer.buttonValue}
                class="hover:bg-white hover:text-black px-4 py-3 md:px-4 md:py-2 text-xs font-title tracking-widest transition-colors duration-300 border hover:border-black bg-[#916B2C] text-white border-transparent inline-block text-center"
                target="_blank" rel="noopener noreferrer"
              >Book Now</a>
) : (
<a
                href={`https://www.book-secure.com/index.php?s=results&property=idbal31692&locale=${locale}_GB&stid=986w12cwy`}
                class="hover:bg-white hover:text-black px-4 py-3 md:px-4 md:py-2 text-xs font-title tracking-widest transition-colors duration-300 border hover:border-black bg-[#916B2C] text-white border-transparent inline-block text-center"
                target="_blank" rel="noopener noreferrer"
              >Book Now</a>
)}


            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  {/* Offers Header Carousel Script */}
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const slides = document.querySelectorAll('.offers-header-slide');
      const prevButton = document.getElementById('offersHeaderPrev');
      const nextButton = document.getElementById('offersHeaderNext');

      if (!slides.length) return;

      let currentSlide = 0;

      function showOffersHeaderSlide(index) {
        slides.forEach((slide, i) => {
          if (i === index) {
            slide.classList.add('opacity-100', 'z-10');
            slide.classList.remove('opacity-0', 'z-0');
          } else {
            slide.classList.add('opacity-0', 'z-0');
            slide.classList.remove('opacity-100', 'z-10');
          }
        });
      }

      function nextOffersHeaderSlide() {
        currentSlide = (currentSlide + 1) % slides.length;
        showOffersHeaderSlide(currentSlide);
      }

      function prevOffersHeaderSlide() {
        currentSlide = (currentSlide - 1 + slides.length) % slides.length;
        showOffersHeaderSlide(currentSlide);
      }

      prevButton?.addEventListener('click', e => {
        e.stopPropagation();
        prevOffersHeaderSlide();
      });

      nextButton?.addEventListener('click', e => {
        e.stopPropagation();
        nextOffersHeaderSlide();
      });

      if (slides.length > 1) {
        setInterval(nextOffersHeaderSlide, 5000);
      }

      showOffersHeaderSlide(currentSlide);
    });
  </script>
</Layout>
