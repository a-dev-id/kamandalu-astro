---
import Layout from '../../../layouts/Base.astro';
import client from '../../../lib/sanityClient';
import { getLocale } from '../../../utils/getLocale';
import OptimizedImage from '../../../components/OptimizedImage.astro';
import { toHTML } from '@portabletext/to-html';

// Helper to format date strings for display
const formatDate = dateStr => new Date(dateStr).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

// Generate static paths for all offers in all supported languages
export async function getStaticPaths() {
  const slugs = await client.fetch(`*[_type == "offer" && defined(slug.current)]{ "slug": slug.current }`);
  const languages = ['en', 'ko', 'zh'];
  return languages.flatMap(lang => slugs.map(offer => ({ params: { lang, slug: offer.slug } })));
}

// Get parameters and locale from Astro
const { lang, slug } = Astro.params;
const locale = getLocale(lang);
const safeArray = arr => Array.isArray(arr) ? arr : [];

// Fetch offer data from Sanity CMS for the current slug and locale
const offer = await client.fetch(`*[_type == "offer" && slug.current == $slug][0]{
  title,
  subtitle,
  excerpt,
  description,
  offerStart,
  offerEnd,
  mainImage { asset->{url} },
  mainImageAlt,
  headerImages[]{
    image {
      asset->{url}
    },
    alt,
    title,
    order
  },
  minNights,
  promoCode,
  metaTitle,
  metaDescription,
  metaKeywords,
  order,
  buttonLabel,
  buttonValue,
  "reserveSection": reserveSection[$locale],
  "inclusionTitle": inclusionTitle[$locale],
  "inclusion": inclusion[$locale],
  "additionalInfoTitle": additionalInfoTitle[$locale],
  "additionalInfo": additionalInfo[$locale],
  "faq": faq[$locale],
  "cancelPolicy": cancelPolicy[$locale],
}`, { slug, locale });

// Prepare offer header slider images, falling back to the main image.
const offerHeaderSlides =
  Array.isArray(offer?.headerImages) && offer.headerImages.length
    ? offer.headerImages
        .filter(slide => slide?.image?.asset?.url)
        .sort((a, b) => (a.order ?? 999) - (b.order ?? 999))
    : offer?.mainImage?.asset?.url
      ? [
          {
            image: offer.mainImage,
            alt: offer.mainImageAlt,
            title: offer.title,
            order: 1,
          },
        ]
      : [];

// Convert inclusion and cancel policy fields to HTML using Portable Text
const htmlListComponents = {
  list: ({ children, value }) =>
    value?.listItem === 'bullet' || value?.style === 'normal'
      ? `<ul class="list-disc ml-6">${children}</ul>`
      : `<ol class="list-decimal ml-6">${children}</ol>`,
  listItem: ({ children }) => `<li class="mt-1">${children}</li>`,
};

const inclusionHTML = toHTML(safeArray(offer.inclusion), {
  components: htmlListComponents,
});

const reserveSectionHTML = toHTML(safeArray(offer.reserveSection), {
  components: htmlListComponents,
});

const additionalInfoHTML = toHTML(safeArray(offer.additionalInfo), {
  components: htmlListComponents,
});

const faqHTML = toHTML(safeArray(offer.faq), {
  components: htmlListComponents,
});

const cancelPolicyHTML = toHTML(safeArray(offer.cancelPolicy), {
  components: htmlListComponents,
});

// Prepare meta and description fields for SEO and display
const offerDescription = toHTML(safeArray(offer.description?.[locale]));
const title = offer?.metaTitle?.[locale] ?? '';
const description = offer?.metaDescription?.[locale] ?? '';
const baseUrl = new URL(Astro.request.url);
const url = baseUrl.href;
const ogImage =
  offerHeaderSlides[0]?.image?.asset?.url ??
  offer.mainImage?.asset?.url ??
  '';
const keywords = offer.metaKeywords?.[locale] ?? '';
---

<Layout {title} {description} {url} {ogImage} {keywords}>
  {/* Hero section with offer header slider */}
  <section class="relative w-full h-[50vh] md:h-[60vh] lg:h-[75vh] overflow-hidden">
    <div id="offer-detail-header-carousel" class="w-full h-full relative">
      {offerHeaderSlides.map((slide, i) => (
        <div
          class={`offer-detail-header-slide w-full h-full absolute inset-0 transition-opacity duration-1000 ${
            i === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'
          }`}
        >
          <OptimizedImage
            src={slide.image?.asset?.url ?? ''}
            alt={slide.alt?.[locale] ?? slide.title?.[locale] ?? offer.mainImageAlt?.[locale] ?? ''}
            width={1600}
            height={900}
            className="w-full h-full object-cover"
            fetchpriority={i === 0 ? 'high' : 'auto'}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </div>
      ))}

      <div class="absolute inset-0 bg-black/25 z-20"></div>

      {offerHeaderSlides.length > 1 && (
        <>
          <button
            aria-label="Previous Offer Header Slide"
            id="offerDetailHeaderPrev"
            class="absolute left-4 top-1/2 -translate-y-1/2 text-white text-3xl z-30"
          >
            &#10094;
          </button>

          <button
            aria-label="Next Offer Header Slide"
            id="offerDetailHeaderNext"
            class="absolute right-4 top-1/2 -translate-y-1/2 text-white text-3xl z-30"
          >
            &#10095;
          </button>
        </>
      )}
    </div>
  </section>

  {/* Offer title and description */}
  <section class="container mx-auto px-4 xl:px-10 2xl:px-0 py-16 md:py-24">
    <div class="text-center px-2 sm:px-6 md:px-8 mx-auto">
      <h1 class="font-title text-3xl sm:text-4xl md:text-5xl mb-4 md:mb-6 tracking-widest font-light">
        {offer?.title?.[locale] ?? ''}
      </h1>
      <!-- <div class="text-lg prose max-w-none" set:html={offerDescription}></div> -->
{
  slug === 'ubud-luxury-private-villa-retreat' ? (
    <div class="featured-offer prose max-w-none" set:html={offerDescription}></div>
  ) : (
    <div class="offer-description prose max-w-none" set:html={offerDescription}></div>
  )
}

<style is:global>
  .offer-description h2,
  .featured-offer h2 {
    font-size: 1.5rem;
    line-height: 1.3;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .offer-description p,
  .featured-offer p {
    margin-top: 0.875rem;
    margin-bottom: 0.875rem;
    font-size: 1rem;
    line-height: 1.75;
  }

  .offer-inclusion h6 {
    font-size: 1.125rem;
    margin-top: 1rem;
    margin-bottom: 1rem;
    line-height: 1.4;
  }

  .reserve-section h2,
  .reserve-section h3,
  .reserve-section h4 {
    font-family: "PlantinLight", sans-serif;
    font-size: 1.375rem;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  .reserve-section p {
    margin-bottom: 0.5rem;
  }

  @media (min-width: 768px) {
    .offer-description h2,
    .featured-offer h2 {
      font-size: 2rem;
    }

    .offer-description p {
      font-size: 1.05rem;
    }

    .featured-offer p {
      font-size: 1.35rem;
    }

    .offer-inclusion h6 {
      font-size: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .offer-description h2,
    .featured-offer h2 {
      font-size: 2rem;
      line-height: 1.2;
    }

    .offer-description p {
      font-size: 1.125rem;
    }

    .featured-offer p {
      font-size: 1.3rem;
    }

    .offer-inclusion h6 {
      font-size: 1.5rem;
    }
  }
</style>
    </div>
  </section>

  {/* What's Included and Booking section */}
  <section class="container mx-auto px-4 xl:px-10 2xl:px-0 pb-8 md:pb-10">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16 xl:gap-24">
      {/* Inclusion list */}
      <div class="min-w-0">
        <h3 class="font-title text-xl md:text-2xl uppercase mb-6">{offer.inclusionTitle}</h3>
        <div class="text-lg max-w-none offer-inclusion" set:html={inclusionHTML}></div>
      </div>
      {/* Offer validity and booking button */}
      <div class="flex flex-col lg:items-end">
        <div>
          <!-- <h3 class="font-title text-xl md:text-2xl uppercase mb-2">Offer Valid</h3>
          <p class="text-lg mb-6">
            {offer.offerStart ? formatDate(offer.offerStart) : ''} - {offer.offerEnd ? formatDate(offer.offerEnd) : ''}
          </p> -->
          <div class="reserve-section text-lg mb-6" set:html={reserveSectionHTML}></div>
{(offer?.buttonLabel?.[locale] && offer?.buttonValue) ? (
  <a
            href={offer.buttonValue}
            class="inline-block px-4 py-3 md:px-4 md:py-2 text-xs font-title tracking-widest border bg-[#916B2C] text-white border-transparent hover:bg-white hover:text-black hover:border-black transition-colors duration-300 text-center"
            target="_blank"
            rel="noopener noreferrer"
          >
            BOOK NOW
          </a>
) : (
 <a
            href="https://www.book-secure.com/index.php?s=results&property=idbal31692&locale=en_GB&currency=IDR&stid=5wzhsz4dj"
            class="inline-block px-4 py-3 md:px-4 md:py-2 text-xs font-title tracking-widest border bg-[#916B2C] text-white border-transparent hover:bg-white hover:text-black hover:border-black transition-colors duration-300 text-center"
            target="_blank"
            rel="noopener noreferrer"
          >
            BOOK NOW
          </a>
)}

        </div>
      </div>
    </div>
  </section>

  {/* Accordions for additional information and cancellation policy */}
  <section class="container mx-auto px-4 xl:px-10 2xl:px-0 pb-12">
    {(offer.additionalInfoTitle || safeArray(offer.additionalInfo).length > 0) && (
      <div class="border-b border-gray-300">
        <button
          id="accordion-trigger-additional-info"
          type="button"
          class="w-full flex justify-between items-center py-4 font-title font-bold text-left text-lg uppercase toggle-btn"
          data-target="accordion-additional-info"
          aria-expanded="false"
          aria-controls="accordion-additional-info"
        >
          {offer.additionalInfoTitle}
          <svg class="w-5 h-5 transition-transform duration-300" data-icon data-target="accordion-additional-info" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="accordion-additional-info" class="grid grid-cols-1 gap-6 pb-6 hidden" role="region" aria-labelledby="accordion-trigger-additional-info">
          <div class="text-lg max-w-none" set:html={additionalInfoHTML}></div>
        </div>
      </div>
    )}
    {safeArray(offer.faq).length > 0 && (
      <div class="border-b border-gray-300">
        <button
          id="accordion-trigger-faq"
          type="button"
          class="w-full flex justify-between items-center py-4 font-title font-bold text-left text-lg uppercase toggle-btn"
          data-target="accordion-faq"
          aria-expanded="false"
          aria-controls="accordion-faq"
        >
          Frequently Asked Questions
          <svg class="w-5 h-5 transition-transform duration-300" data-icon data-target="accordion-faq" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="accordion-faq" class="grid grid-cols-1 gap-6 pb-6 hidden" role="region" aria-labelledby="accordion-trigger-faq">
          <div class="text-lg max-w-none" set:html={faqHTML}></div>
        </div>
      </div>
    )}
    <div class="border-b border-gray-300">
      <button
        id="accordion-trigger-policy"
        type="button"
        class="w-full flex justify-between items-center py-4 font-title font-bold text-left text-lg uppercase toggle-btn"
        data-target="accordion-1"
        aria-expanded="false"
        aria-controls="accordion-1"
      >
        Policies, Terms & Conditions
        {/* SVG icon for accordion toggle */}
        <svg class="w-5 h-5 transition-transform duration-300" data-icon data-target="accordion-1" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div id="accordion-1" class="grid grid-cols-1 gap-6 pb-6 hidden" role="region" aria-labelledby="accordion-trigger-policy">
        <div class="text-lg max-w-none" set:html={cancelPolicyHTML}></div>
      </div>
    </div>
  </section>

  {/* Offer Header Carousel Script */}
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const slides = document.querySelectorAll('.offer-detail-header-slide');
      const prevButton = document.getElementById('offerDetailHeaderPrev');
      const nextButton = document.getElementById('offerDetailHeaderNext');

      if (!slides.length) return;

      let currentSlide = 0;

      function showOfferHeaderSlide(index) {
        slides.forEach((slide, i) => {
          if (i === index) {
            slide.classList.add('opacity-100', 'z-10');
            slide.classList.remove('opacity-0', 'z-0');
          } else {
            slide.classList.add('opacity-0', 'z-0');
            slide.classList.remove('opacity-100', 'z-10');
          }
        });
      }

      function nextOfferHeaderSlide() {
        currentSlide = (currentSlide + 1) % slides.length;
        showOfferHeaderSlide(currentSlide);
      }

      function prevOfferHeaderSlide() {
        currentSlide = (currentSlide - 1 + slides.length) % slides.length;
        showOfferHeaderSlide(currentSlide);
      }

      prevButton?.addEventListener('click', event => {
        event.stopPropagation();
        prevOfferHeaderSlide();
      });

      nextButton?.addEventListener('click', event => {
        event.stopPropagation();
        nextOfferHeaderSlide();
      });

      if (slides.length > 1) {
        setInterval(nextOfferHeaderSlide, 5000);
      }

      showOfferHeaderSlide(currentSlide);
    });
  </script>

  {/* Inline script for accordion toggle functionality */}
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.toggle-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const targetId = btn.dataset.target;
          const panel = document.getElementById(targetId);
          const icon = document.querySelector(`svg[data-icon][data-target="${targetId}"]`);
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!expanded));
          panel.classList.toggle('hidden');
          icon.classList.toggle('rotate-180');
        });
      });
    });
  </script>
</Layout>
