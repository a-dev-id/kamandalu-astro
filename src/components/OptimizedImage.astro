---
const {
  src,
  alt = '',
  width = 800,
  height = 600,
  className = '',
  fetchpriority = 'auto',
  loading = 'lazy',
} = Astro.props;
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  fetchpriority={fetchpriority}
  class={`object-cover ${className}`}
/>
