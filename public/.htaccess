# Redirect remaining www requests to the HTTPS non-www domain.
# Keep this after specific mappings and before the generic fallback.
# The original path and query string are preserved.
RewriteCond %{HTTP_HOST} ^www\.kamandaluresort\.com(?::[0-9]+)?$ [NC]
RewriteRule ^ https://kamandaluresort.com%{REQUEST_URI} [R=301,L,NE]

# No mapping was supplied for /cooking-demo-chef-wan.html; no specific rule added.
# NOTE: The fallback below is preserved from the original .htaccess.
# SEO improvement to consider separately: remove this fallback and return 404
# for genuinely unknown URLs, rather than redirecting them all to the homepage.

# Original generic fallback - LAST (otherwise it overrides specific redirects)
RewriteCond %{HTTP_HOST} ^(www\.)?kamandaluresort\.com(?::[0-9]+)?$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ /en [R=301,L]

# END Kamandalu redirects
