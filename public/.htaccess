# Kamandalu Ubud - updated redirects (13 Oct 2026)
# All mappings are permanent and apply to kamandaluresort.com / www.kamandaluresort.com.
# IMPORTANT: Specific redirects must be before the generic fallback.

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 year"

  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

Header set Cache-Control "public, max-age=31536000, immutable"

Options -Indexes
RewriteEngine On

# Existing dedicated mail subdomain redirects
RewriteCond %{HTTP_HOST} ^mail\.kamandaluresort\.com(?::[0-9]+)?$ [NC]
RewriteRule ^en/ubud-experiences-and-activities/signature-experiences/romantic-flower-bath-ubud/?$ https://kamandaluresort.com/en/ubud-experiences-and-activities/signature-experiences/romantic-flower-bath-ubud/ [R=301,L]

RewriteCond %{HTTP_HOST} ^mail\.kamandaluresort\.com(?::[0-9]+)?$ [NC]
RewriteRule ^en/ubud-experiences-and-activities/leisure-family/infinity-pool-day-pass-ubud/?$ https://kamandaluresort.com/en/ubud-experiences-and-activities/leisure-family/infinity-pool-day-pass-ubud/ [R=301,L]

RewriteCond %{HTTP_HOST} ^mail\.kamandaluresort\.com(?::[0-9]+)?$ [NC]
RewriteRule ^en/ubud-experiences-and-activities/signature-experiences/private-chef-bbq-dinner-in-ubud/?$ https://kamandaluresort.com/en/ubud-experiences-and-activities/signature-experiences/private-chef-bbq-dinner-in-ubud/ [R=301,L]

# BEGIN Kamandalu main-site redirects

